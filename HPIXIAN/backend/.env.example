# Copia este archivo a ".env" (mismo directorio) y ajusta los valores reales.
# El archivo ".env" real NUNCA debe subirse a git — agrégalo a .gitignore.

DB_HOST=localhost
DB_PORT=3306
DB_USER=horapix_app
DB_PASSWORD=cambia_esta_clave
DB_NAME=HPP1

# Genera un valor propio, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_este_valor_por_uno_generado_aleatoriamente
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=45

# En local sin certificado HTTPS, pon esto en False solo para poder probar.
# En producción SIEMPRE debe quedar en True.
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# Dominio(s) exactos donde corre el frontend. Nunca "*" (rompe las cookies).
CORS_ORIGINS=["http://localhost:5500"]

ENVIRONMENT=development
